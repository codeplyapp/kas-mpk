# ===================================================
# DATABASE CONFIGURATION (Supabase / Neon / PostgreSQL)
# ===================================================
# Dapatkan DATABASE_URL dan DIRECT_URL dari Dashboard Supabase:
# Settings -> Database -> Connection string -> URI / Transaction Pooler (port 6543) & Session Pooler (port 5432)

# Connection Pooler URL (untuk query transaksi di Vercel Serverless)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct URL (untuk migration / prisma db push)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ===================================================
# AUTHENTICATION SECRET
# ===================================================
# Secret string acak untuk enkripsi JWT Session Cookie (minimal 32 karakter)
JWT_SECRET="mpk_trenggana_sumapala_secure_secret_key_2026_2027_production"

# ===================================================
# UPSTASH REDIS (Fast Real-time Caching & Invalidation)
# ===================================================
UPSTASH_REDIS_REST_URL="https://[YOUR_UPSTASH_INSTANCE].upstash.io"
UPSTASH_REDIS_REST_TOKEN="[YOUR_UPSTASH_TOKEN]"
